{
  "name": "htb-llm",
  "version": "0.1.36",
  "private": true,
  "type": "module",
  "description": "HTB LLM — неофициальный локальный LLM-ассистент для HackTheBox и HTB Academy: Kali на задачу, VPN, RAG и подтверждаемая память",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "knowledge": "npx tsx scripts/knowledge.mts",
    "test:e2e": "vite build --config web/vite.config.ts && playwright test",
    "test:e2e:update": "vite build --config web/vite.config.ts && playwright test --update-snapshots"
  },
  "dependencies": {
    "@langchain/core": "^1.3.3",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "dockerode": "^5.0.1",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "playwright-core": "1.64.1",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^2.1.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
