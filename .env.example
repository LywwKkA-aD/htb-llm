# Необязательные переменные для docker/run.sh и Docker Compose.
# Ключи OpenRouter и HTB сюда класть НЕ надо: они вводятся в веб-интерфейсе и хранятся в data/.

# Порт веб-интерфейса на 127.0.0.1
HTB_LLM_PORT=7331

# Свой секрет внутреннего SearXNG (порт наружу не публикуется)
SEARXNG_SECRET=change-me-local-only

# Необязательный свой тег образа Kali
# WH_IMAGE=htb-llm-kali:latest

# Локальные llama-server на хосте, если не используешь OpenRouter
# WH_LLM_URL=http://host.docker.internal:8080/v1
# WH_EMBED_URL=http://host.docker.internal:8081/v1
